{
  "version": 1,
  "installCommand": "cd backend && npm install",
  "buildCommand": "cd backend && npm run build",
  "outputDirectory": "backend/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://gourshal-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
