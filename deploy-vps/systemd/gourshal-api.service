[Unit]
Description=Gourshal Backend API
Documentation=https://github.com/your-repo/gourshal
After=network.target mysql.service mongodb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/gourshal-backend
Environment=NODE_ENV=production
Environment=PORT=5000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gourshal-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/gourshal-backend

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
